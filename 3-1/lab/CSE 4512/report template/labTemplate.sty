% custom Page style
\pagestyle{fancy}
\fancyhf{} % Clear default header and footer
\setlength{\headheight}{14.5pt}
% Custom Header
\fancyhead[R]{\thepage} % Right portion of the header contains page number
\fancyhead[L]{\nouppercase\leftmark} % Left portion of the header contains chapter/section name
\renewcommand{\headrulewidth}{0.01pt} % Thickness of the header rule line
% Custom Footer
\fancyfoot[R]{\StudentID} % Right portion of the footer contains student ID
\fancyfoot[C]{Lab \LabNo} % Center portion of the footer contains lab number
\fancyfoot[L]{CSE 4512} % Left portion of the footer contains course code
\renewcommand{\footrulewidth}{0.01pt} % Thickness of the footer rule line

% Update the \chaptermark command
\makeatletter
\renewcommand{\chaptermark}[1]{%
    \markboth{Task \thechapter:\ \MakeUppercase{#1}}{}%
}
\makeatother


% Custom \task command
\newcounter{taskcounter}
\newcommand{\task}{\stepcounter{taskcounter}\chapter}
\renewcommand{\thechapter}{\arabic{taskcounter}}

% Modify chapter command
\makeatletter
\let\oldchapter\chapter
\renewcommand{\chapter}{\@ifstar\chap@starchapter\chap@chapter}
\newcommand{\chap@starchapter}{\newpage\thispagestyle{fancy}\oldchapter*}
\newcommand{\chap@chapter}[1]{\newpage\thispagestyle{fancy}\oldchapter{#1}\thispagestyle{fancy}}
\makeatother

% Custom section and chapter titles
\titleformat{\chapter}[block]{\centering\normalfont\Large\bfseries}{Task\ \thechapter:}{12pt}{\Large}
\titlespacing*{\chapter}{0pt}{-30pt}{40pt}
\titleformat{\section}{\normalfont\Large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\large\bfseries}{\thesubsection}{1em}{}